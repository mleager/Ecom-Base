# Copy to .env and populate the three database passwords and JWT secret.
# scripts/dev.ps1 and scripts/dev.sh read plain KEY=value without shell expansion.
APP_ENV=local
HTTP_ADDR=127.0.0.1:8080
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_PORT=5432
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_DB_PASSWORD=
# Base64 encoding of at least 32 cryptographically random bytes.
JWT_SECRET_BASE64=

# Local default: no email. Production requires smtp and every SMTP field below.
# Use literal unquoted KEY=value; TLS mode is lowercase tls or starttls.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=
SMTP_TLS_MODE=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Optional opt-in smoke-test recipient: a mailbox you control, never customer data.
ECOM_MAIL_TEST_RECIPIENT=

# HTTPS (Milestone 14). Leave commented for the default HTTP development flow.
# TLS files must be set together; production requires them. Create local
# certificates with scripts/certs.sh, e.g. .cache/certs/server.pem and server.key.
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# Optional built frontend directory (e.g. frontend/dist) served from the API
# origin (Milestone 14 task 4; not yet implemented).
# STATIC_DIR=

