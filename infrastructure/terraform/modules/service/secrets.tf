# Application secrets. Generated by Terraform, so they are also in Terraform
# state: keep the state private (README, "State holds secrets").

resource "random_bytes" "jwt" {
  length = 32
}

resource "random_password" "smtp" {
  length  = 32
  special = false
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.name}/app"
  description             = "API secrets and internal TLS keys (development stack)"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({
    JWT_SECRET_BASE64 = random_bytes.jwt.base64
    SMTP_PASSWORD     = random_password.smtp.result
    API_TLS_KEY       = tls_private_key.api.private_key_pem_pkcs8
    MAIL_TLS_KEY      = tls_private_key.mail.private_key_pem_pkcs8
    ORIGIN_VERIFY     = var.origin_verify_secret
  })
}

locals {
  # ECS "valueFrom" for one JSON key, pinned to the exact secret version so a
  # new value always rolls the task definition.
  app_secret = { for k in ["JWT_SECRET_BASE64", "SMTP_PASSWORD", "API_TLS_KEY", "MAIL_TLS_KEY"] :
    k => "${aws_secretsmanager_secret.app.arn}:${k}::${aws_secretsmanager_secret_version.app.version_id}"
  }
  db_secret = { for k in ["MASTER_PASSWORD", "MIGRATOR_PASSWORD", "APP_DB_PASSWORD", "MIGRATE_DATABASE_URL", "API_DATABASE_URL"] :
    k => "${var.database.secret_arn}:${k}::${var.database.secret_version_id}"
  }
}
