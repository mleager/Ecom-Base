# Application secrets. Generated by Terraform, so they are also in Terraform
# state: keep the state private (README, "State holds secrets").
#
# One secret per consumer, because IAM grants GetSecretValue per secret, not
# per JSON key: the API's execution role cannot read the mail key, and the
# reverse. Database credentials come from the database module, one secret
# per role.

resource "random_bytes" "jwt" {
  length = 32
}

resource "random_password" "smtp" {
  length  = 32
  special = false
}

locals {
  service_secrets = {
    api = {
      description = "API secrets: JWT key, SMTP password and internal TLS key (development stack)"
      values = {
        JWT_SECRET_BASE64 = random_bytes.jwt.base64
        SMTP_PASSWORD     = random_password.smtp.result
        API_TLS_KEY       = tls_private_key.api.private_key_pem_pkcs8
      }
    }
    mail = {
      description = "Mailpit internal TLS key (development stack)"
      values = {
        MAIL_TLS_KEY = tls_private_key.mail.private_key_pem_pkcs8
      }
    }
  }
}

resource "aws_secretsmanager_secret" "service" {
  for_each = local.service_secrets

  name                    = "${var.name}/${each.key}"
  description             = each.value.description
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "service" {
  for_each = local.service_secrets

  secret_id     = aws_secretsmanager_secret.service[each.key].id
  secret_string = jsonencode(each.value.values)
}

locals {
  # ECS "valueFrom" for one JSON key, pinned to the exact secret version so a
  # new value always rolls the task definition.
  api_secret = { for k in keys(local.service_secrets.api.values) :
    k => "${aws_secretsmanager_secret.service["api"].arn}:${k}::${aws_secretsmanager_secret_version.service["api"].version_id}"
  }
  mail_secret = { for k in keys(local.service_secrets.mail.values) :
    k => "${aws_secretsmanager_secret.service["mail"].arn}:${k}::${aws_secretsmanager_secret_version.service["mail"].version_id}"
  }
  role_secret = { for role, s in var.database.role_secrets : role => {
    PASSWORD     = "${s.arn}:PASSWORD::${s.version_id}"
    DATABASE_URL = "${s.arn}:DATABASE_URL::${s.version_id}"
  } }
  # Not pinned: RDS rotates it, and db-bootstrap reads the current value.
  master_password = "${var.database.master_secret_arn}:password::"
}
