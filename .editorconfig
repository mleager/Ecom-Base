root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,jsx,ts,tsx,json,html,css}]
indent_style = space
indent_size = 2

[*.{yaml,yml,md,ps1,sh}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 1

[*.md]
trim_trailing_whitespace = false

